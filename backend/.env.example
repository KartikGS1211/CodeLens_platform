# ─────────────────────────────────────────
#  Backend Environment Variables
#  Copy this to .env and fill in real values
# ─────────────────────────────────────────

# Node environment — MUST be "production" on Render
NODE_ENV=production

# Express session secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_strong_random_secret

# PostgreSQL connection string (Neon / Render Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Must match exactly what is set in the GitHub OAuth App "Authorization callback URL" field
GITHUB_CALLBACK_URL=https://YOUR_RENDER_DOMAIN.onrender.com/api/auth/github/callback

# Your Vercel frontend URL — used for post-login redirect and CORS
FRONTEND_URL=https://code-lens.platform.vercel.app

# Groq API key for AI analysis
GROQ_API_KEY=your_groq_api_key

# GitHub Personal Access Token (for higher API rate limits)
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
