datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Analysis {
  id       String  @id @default(uuid())
  repoUrl  String
  repoName String?
  status   String  @default("processing")

  //Repo status
  languages String[]
  commits   Int?
  files     Int?

  //Ai results
  codeQuality       Json?
  codeQualitySource String? // "ai" | "fallback"
  aiReview          Json?
  skillsProfile     Json?
  bestPractices     Json?

  createdAt DateTime @default(now())
}
